#!/usr/bin/env bash
# MediaForge optional CLI helper — discoverability + small workflows.
# Does NOT replace ffmpeg/ffprobe. Real work is always delegated upstream.
# Process invocation uses argv arrays (no eval of user input).
set -euo pipefail

FFMPEG="${FFMPEG:-ffmpeg}"
FFPROBE="${FFPROBE:-ffprobe}"
HELPER_VERSION="1.6 (Stage 5B MF-S5-01)"
INSPECT_SCHEMA_VERSION="1"
PLAN_SCHEMA_VERSION="1"

usage() {
  cat <<'EOF'
MediaForge helper (optional) — compatibility-first wrapper around FFmpeg tools.

Usage:
  mediaforge help
  mediaforge recipes
  mediaforge version

  mediaforge inspect <input> [--json]
                                          Summary via ffprobe (human or JSON schema v1)
  mediaforge thumbnail <input> <output> [--time TS]
                                          Extract one frame (default TS=00:00:01)
  mediaforge extract-audio <input> <output>
                                          Audio only (-vn); codec by output extension
  mediaforge hwinfo                       List hwaccels / hw encoders / runtime probe

  mediaforge process <input> -o <output> [options]
                                          Plan/execute conversion (--smart opt-in)
                                          --smart --plan [--json] --width --height
                                          --video-codec --audio-codec
  mediaforge probe [ffprobe-args...]
  mediaforge ffmpeg [ffmpeg-args...]
  mediaforge run [ffmpeg-args...]

Environment:
  FFMPEG   path to ffmpeg  (default: ffmpeg)
  FFPROBE  path to ffprobe (default: ffprobe)

Standard FFmpeg CLIs remain the primary interface.
See docs/cli/EXAMPLES.md and docs/media/.
EOF
}

recipes() {
  cat <<'EOF'
Common recipes (also: mediaforge inspect|thumbnail|extract-audio):

  Inspect JSON (MediaForge schema v1):
    mediaforge inspect INPUT --json

  Inspect (raw ffprobe JSON):
    ffprobe -v quiet -print_format json -show_format -show_streams INPUT

  Remux copy:
    ffmpeg -nostdin -y -i INPUT -c copy OUTPUT

  Extract audio:
    mediaforge extract-audio INPUT OUT.wav

  Thumbnail:
    mediaforge thumbnail INPUT thumb.jpg --time 00:00:05

Full list: docs/cli/EXAMPLES.md
EOF
}

die() {
  echo "mediaforge: error: $*" >&2
  exit 1
}

hint() {
  echo "mediaforge: hint: $*" >&2
}

need_tools() {
  if ! command -v "$FFMPEG" >/dev/null 2>&1; then
    die "ffmpeg not found on PATH (set FFMPEG=/path/to/ffmpeg)"
  fi
  if ! command -v "$FFPROBE" >/dev/null 2>&1; then
    die "ffprobe not found on PATH (set FFPROBE=/path/to/ffprobe)"
  fi
}

# Fail early: readable regular file or lavfi/device-style inputs starting with special schemes are passed through.
require_input_path() {
  local path="$1"
  if [ -z "$path" ]; then
    die "input path is empty"
  fi
  # Allow lavfi and explicit protocol URLs for power users
  case "$path" in
    *://*|lavfi:*) return 0 ;;
  esac
  if [ ! -e "$path" ]; then
    die "input does not exist: $path"
    # unreachable
  fi
  if [ ! -r "$path" ]; then
    die "input is not readable: $path"
  fi
  if [ -d "$path" ]; then
    die "input is a directory, expected a media file: $path"
  fi
}

require_output_parent() {
  local out="$1"
  local dir
  dir="$(dirname -- "$out")"
  if [ ! -d "$dir" ]; then
    die "output directory does not exist: $dir"
  fi
  if [ ! -w "$dir" ]; then
    die "output directory is not writable: $dir"
  fi
}

validate_output_file() {
  local out="$1"
  if [ ! -f "$out" ]; then
    die "processing reported success but output file is missing: $out"
  fi
  if [ ! -s "$out" ]; then
    die "output file is empty: $out"
  fi
  # Lightweight probe; do not fail the whole tool if probe is overly strict on images
  if ! "$FFPROBE" -v error -show_entries format=format_name -of csv=p=0 "$out" >/dev/null 2>&1; then
    hint "ffprobe could not summarize output (file exists and is non-empty): $out"
  fi
}

json_escape() {
  # Minimal JSON string escape for control characters and quotes
  python3 -c 'import json,sys; print(json.dumps(sys.argv[1]))' "$1"
}

cmd_inspect() {
  need_tools
  local input="" json=0
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --json) json=1; shift ;;
      -h|--help)
        echo "usage: mediaforge inspect <input> [--json]"
        return 0
        ;;
      -*)
        die "unknown inspect option: $1 (try --json)"
        ;;
      *)
        if [ -n "$input" ]; then
          die "unexpected argument: $1"
        fi
        input="$1"
        shift
        ;;
    esac
  done
  [ -n "$input" ] || die "usage: mediaforge inspect <input> [--json]"
  require_input_path "$input"

  if [ "$json" -eq 1 ]; then
    # Compose MediaForge schema v1 from ffprobe JSON (stable subset)
    local raw
    if ! raw="$("$FFPROBE" -v quiet -print_format json -show_format -show_streams "$input" 2>/dev/null)"; then
      die "ffprobe failed for input: $input (is it a supported media file?)"
    fi
    MF_VER="unknown"
    ROOT="$(cd "$(dirname "$0")/.." && pwd)"
    if [ -f "$ROOT/VERSION" ]; then
      MF_VER="$(tr -d '[:space:]' < "$ROOT/VERSION")"
    fi
    INSPECT_RAW="$raw" MF_VER="$MF_VER" SCHEMA="$INSPECT_SCHEMA_VERSION" INPUT_PATH="$input" python3 - <<'PY'
import json, os
raw = os.environ["INSPECT_RAW"]
data = json.loads(raw)
fmt = data.get("format") or {}
streams_out = []
for s in data.get("streams") or []:
    streams_out.append({
        "index": s.get("index"),
        "codec_type": s.get("codec_type"),
        "codec_name": s.get("codec_name"),
        "width": s.get("width"),
        "height": s.get("height"),
        "pix_fmt": s.get("pix_fmt"),
        "sample_rate": s.get("sample_rate"),
        "channels": s.get("channels"),
        "channel_layout": s.get("channel_layout"),
        "r_frame_rate": s.get("r_frame_rate"),
        "bit_rate": s.get("bit_rate"),
    })
out = {
    "tool": "mediaforge",
    "schema_version": int(os.environ["SCHEMA"]),
    "version": os.environ["MF_VER"],
    "input": os.environ["INPUT_PATH"],
    "format": {
        "format_name": fmt.get("format_name"),
        "duration": fmt.get("duration"),
        "size": fmt.get("size"),
        "bit_rate": fmt.get("bit_rate"),
    },
    "streams": streams_out,
    "warnings": [],
}
print(json.dumps(out, indent=2, sort_keys=False))
PY
    return 0
  fi

  echo "=== MediaForge inspect ==="
  echo "input: $input"
  if ! "$FFPROBE" -v error \
    -show_entries format=format_name,duration,size,bit_rate \
    -show_entries stream=index,codec_type,codec_name,width,height,pix_fmt,sample_rate,channels,channel_layout,r_frame_rate \
    -of default=noprint_wrappers=1:nokey=0 \
    "$input"
  then
    die "ffprobe failed for input: $input"
  fi
}

cmd_thumbnail() {
  need_tools
  [ "$#" -ge 2 ] || die "usage: mediaforge thumbnail <input> <output> [--time TS]"
  local input="$1" output="$2" ts="00:00:01"
  shift 2
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --time)
        [ "$#" -ge 2 ] || die "--time requires a value (example: 00:00:01)"
        ts="$2"
        shift 2
        ;;
      *) die "unknown option: $1 (supported: --time)" ;;
    esac
  done
  require_input_path "$input"
  require_output_parent "$output"
  if ! "$FFMPEG" -nostdin -y -hide_banner -loglevel error \
    -ss "$ts" -i "$input" -frames:v 1 "$output"
  then
    die "thumbnail failed (check codec support and --time within media duration)"
  fi
  validate_output_file "$output"
}

cmd_extract_audio() {
  need_tools
  [ "$#" -ge 2 ] || die "usage: mediaforge extract-audio <input> <output>"
  local input="$1" output="$2"
  require_input_path "$input"
  require_output_parent "$output"
  local ext="${output##*.}"
  ext="$(printf '%s' "$ext" | tr 'A-Z' 'a-z')"
  local -a audio_opts
  case "$ext" in
    wav) audio_opts=(-c:a pcm_s16le) ;;
    mp3) audio_opts=(-c:a libmp3lame -q:a 2) ;;
    m4a|aac) audio_opts=(-c:a aac -b:a 192k) ;;
    opus) audio_opts=(-c:a libopus -b:a 128k) ;;
    flac) audio_opts=(-c:a flac) ;;
    *) audio_opts=(-c:a copy) ;;
  esac
  if ! "$FFMPEG" -nostdin -y -hide_banner -loglevel error \
    -i "$input" -vn "${audio_opts[@]}" "$output"
  then
    die "extract-audio failed (try a different output extension, e.g. .wav)"
  fi
  validate_output_file "$output"
}

cmd_hwinfo() {
  need_tools
  echo "=== MediaForge hwinfo ==="
  echo "ffmpeg: $(command -v "$FFMPEG")"
  echo "--- hwaccels (build/list) ---"
  "$FFMPEG" -hide_banner -hwaccels 2>/dev/null || true
  echo "--- hardware-ish encoders (name match) ---"
  "$FFMPEG" -hide_banner -encoders 2>/dev/null | grep -iE 'nvenc|qsv|vaapi|amf|videotoolbox|v4l2m2m|vulkan|cuda' || echo "(none listed)"
  echo "--- hardware-ish decoders (name match) ---"
  "$FFMPEG" -hide_banner -decoders 2>/dev/null | grep -iE 'cuvid|nvdec|qsv|vaapi|videotoolbox|v4l2m2m|vulkan|cuda' || echo "(none listed)"
  echo "--- runtime probe ---"
  if [ -d /dev/dri ]; then
    echo "dri_nodes: $(ls /dev/dri 2>/dev/null | tr '\n' ' ')"
  else
    echo "dri_nodes: (none)"
  fi
  if command -v nvidia-smi >/dev/null 2>&1; then
    echo "nvidia-smi: available"
    nvidia-smi -L 2>/dev/null | head -5 || true
  else
    echo "nvidia-smi: not found"
  fi
  echo "note: listed encoders require matching drivers/devices at runtime"
}

cmd_process() {
  need_tools
  local input="" output="" smart=0 plan_only=0 json=0
  local tw="" th="" tvc="" tac=""
  while [ "$#" -gt 0 ]; do
    case "$1" in
      -o|--output)
        [ "$#" -ge 2 ] || die "--output requires a path"
        output="$2"; shift 2 ;;
      --smart) smart=1; shift ;;
      --plan) plan_only=1; shift ;;
      --json) json=1; shift ;;
      --width)
        [ "$#" -ge 2 ] || die "--width requires a positive integer"
        tw="$2"; shift 2 ;;
      --height)
        [ "$#" -ge 2 ] || die "--height requires a positive integer"
        th="$2"; shift 2 ;;
      --video-codec)
        [ "$#" -ge 2 ] || die "--video-codec requires a name (e.g. h264, mpeg4, copy)"
        tvc="$2"; shift 2 ;;
      --audio-codec)
        [ "$#" -ge 2 ] || die "--audio-codec requires a name (e.g. aac, pcm_s16le, copy)"
        tac="$2"; shift 2 ;;
      -h|--help)
        echo "usage: mediaforge process <input> -o <output> [--smart] [--plan] [--json]"
        echo "         [--width N] [--height N] [--video-codec NAME] [--audio-codec NAME]"
        return 0 ;;
      -*)
        die "unknown process option: $1" ;;
      *)
        if [ -n "$input" ]; then
          die "unexpected argument: $1"
        fi
        input="$1"; shift ;;
    esac
  done
  [ -n "$input" ] || die "usage: mediaforge process <input> -o <output> ..."
  [ -n "$output" ] || die "output is required (-o/--output)"
  require_input_path "$input"
  if [ "$plan_only" -eq 0 ]; then
    require_output_parent "$output"
  fi
  if [ -n "$tw" ]; then
    case "$tw" in
      *[!0-9]*|"") die "target width must be a positive integer" ;;
    esac
    [ "$tw" -gt 0 ] || die "target width must be greater than zero"
  fi
  if [ -n "$th" ]; then
    case "$th" in
      *[!0-9]*|"") die "target height must be a positive integer" ;;
    esac
    [ "$th" -gt 0 ] || die "target height must be greater than zero"
  fi

  local raw
  if ! raw="$("$FFPROBE" -v quiet -print_format json -show_format -show_streams "$input" 2>/dev/null)"; then
    die "ffprobe failed for input: $input (is it a supported media file?)"
  fi

  local plan_json
  plan_json="$(
    INPUT_PATH="$input" OUTPUT_PATH="$output" SMART="$smart" \
    TW="$tw" TH="$th" TVC="$tvc" TAC="$tac" \
    RAW="$raw" SCHEMA="$PLAN_SCHEMA_VERSION" \
    python3 - <<'PY'
import json, os
raw = os.environ["RAW"]
data = json.loads(raw)
fmt = data.get("format") or {}
streams = data.get("streams") or []
v = next((s for s in streams if s.get("codec_type") == "video"), None)
a = next((s for s in streams if s.get("codec_type") == "audio"), None)
tw = os.environ.get("TW") or ""
th = os.environ.get("TH") or ""
tvc = (os.environ.get("TVC") or "").strip().lower()
tac = (os.environ.get("TAC") or "").strip().lower()
smart = os.environ.get("SMART") == "1"
out_path = os.environ["OUTPUT_PATH"]
ext = out_path.rsplit(".", 1)[-1].lower() if "." in out_path else ""

iw = v.get("width") if v else None
ih = v.get("height") if v else None
ivc = (v.get("codec_name") or "").lower() if v else ""
iac = (a.get("codec_name") or "").lower() if a else ""

needs_scale = False
if tw or th:
    if v is None:
        needs_scale = True
    else:
        if tw and int(tw) != int(iw or -1):
            needs_scale = True
        if th and int(th) != int(ih or -1):
            needs_scale = True

needs_vcodec = False
if tvc and tvc != "copy":
    if not ivc or tvc != ivc:
        needs_vcodec = True

needs_acodec = False
if tac and tac != "copy":
    if not iac or tac != iac:
        needs_acodec = True

if smart and not needs_scale and not needs_vcodec and not needs_acodec:
    decision = "STREAM_COPY"
    reason = "requested properties already satisfied; stream-copy/remux"
    action = {"type": "stream_copy", "scale": False}
elif not smart:
    decision = "PROCESS"
    reason = "smart mode disabled; always run conversion path for requested targets"
    action = {
        "type": "process",
        "scale": bool(tw or th),
        "video_codec": tvc or None,
        "audio_codec": tac or None,
    }
else:
    decision = "PROCESS"
    parts = []
    if needs_scale:
        parts.append("scale required")
    if needs_vcodec:
        parts.append("video codec conversion required")
    if needs_acodec:
        parts.append("audio codec conversion required")
    reason = "; ".join(parts) if parts else "processing required"
    action = {
        "type": "process",
        "scale": needs_scale,
        "target_width": int(tw) if tw else None,
        "target_height": int(th) if th else None,
        "video_codec": tvc or None,
        "audio_codec": tac or None,
    }

plan = {
    "tool": "mediaforge",
    "operation": "process",
    "schema_version": int(os.environ["SCHEMA"]),
    "smart": smart,
    "decision": decision,
    "reason": reason,
    "input": {
        "path": os.environ["INPUT_PATH"],
        "format_name": fmt.get("format_name"),
        "width": iw,
        "height": ih,
        "video_codec": ivc or None,
        "audio_codec": iac or None,
    },
    "target": {
        "path": out_path,
        "width": int(tw) if tw else None,
        "height": int(th) if th else None,
        "video_codec": tvc or None,
        "audio_codec": tac or None,
        "container_hint": ext or None,
    },
    "action": action,
}
print(json.dumps(plan))
PY
  )" || die "failed to build process plan"

  if [ "$json" -eq 1 ]; then
    printf '%s\n' "$plan_json" | python3 -m json.tool
  else
    echo "=== MediaForge Smart Plan ==="
    echo "input: $input"
    echo "output: $output"
    echo "smart: $smart"
    printf '%s' "$plan_json" | python3 -c '
import json,sys
p=json.load(sys.stdin)
print("decision:", p["decision"])
print("reason:", p["reason"])
inp, tgt = p["input"], p["target"]
print("video: {}x{} {}".format(inp.get("width"), inp.get("height"), inp.get("video_codec")))
print("audio:", inp.get("audio_codec"))
print("target: w={} h={} vcodec={} acodec={}".format(
    tgt.get("width"), tgt.get("height"), tgt.get("video_codec"), tgt.get("audio_codec")))
print("action:", p["action"].get("type"))
'
  fi

  if [ "$plan_only" -eq 1 ]; then
    return 0
  fi

  local decision
  decision="$(printf '%s' "$plan_json" | python3 -c 'import json,sys; print(json.load(sys.stdin)["decision"])')"

  local -a args
  args=(-nostdin -y -hide_banner -loglevel error -i "$input")

  if [ "$decision" = "STREAM_COPY" ]; then
    args+=(-c copy)
    echo "mediaforge: action: stream_copy (-c copy)"
  else
    local do_scale=0
    if [ "$smart" -eq 1 ]; then
      do_scale="$(printf '%s' "$plan_json" | python3 -c 'import json,sys; print(1 if json.load(sys.stdin)["action"].get("scale") else 0)')"
    else
      if [ -n "$tw" ] || [ -n "$th" ]; then
        do_scale=1
      fi
    fi
    if [ "$do_scale" = "1" ]; then
      local sw sh
      sw="$tw"
      sh="$th"
      if [ -z "$sw" ]; then
        sw="$(printf '%s' "$plan_json" | python3 -c 'import json,sys; print(json.load(sys.stdin)["input"].get("width") or "")')"
      fi
      if [ -z "$sh" ]; then
        sh="$(printf '%s' "$plan_json" | python3 -c 'import json,sys; print(json.load(sys.stdin)["input"].get("height") or "")')"
      fi
      if [ -n "$sw" ] && [ -n "$sh" ]; then
        args+=(-vf "scale=${sw}:${sh}")
        echo "mediaforge: action: scale ${sw}x${sh}"
      fi
    fi
    if [ -n "$tvc" ] && [ "$tvc" != "copy" ]; then
      args+=(-c:v "$tvc")
      echo "mediaforge: action: video_codec $tvc"
    elif [ "$tvc" = "copy" ]; then
      args+=(-c:v copy)
    fi
    if [ -n "$tac" ] && [ "$tac" != "copy" ]; then
      args+=(-c:a "$tac")
      echo "mediaforge: action: audio_codec $tac"
    elif [ "$tac" = "copy" ]; then
      args+=(-c:a copy)
    fi
    if [ "$do_scale" != "1" ] && [ -z "$tvc" ] && [ -z "$tac" ]; then
      args+=(-c copy)
      echo "mediaforge: action: stream_copy (no conversion targets)"
    fi
  fi

  args+=("$output")
  if ! "$FFMPEG" "${args[@]}"; then
    die "process failed (check codecs/filters available in this FFmpeg build)"
  fi
  validate_output_file "$output"
  echo "mediaforge: wrote $output"
}

cmd="${1:-help}"
shift || true

case "$cmd" in
  help|-h|--help) usage ;;
  recipes|examples) recipes ;;
  version|--version)
    ROOT="$(cd "$(dirname "$0")/.." && pwd)"
    MF_VER="unknown"
    if [ -f "$ROOT/VERSION" ]; then
      MF_VER="$(tr -d '[:space:]' < "$ROOT/VERSION")"
    fi
    COMMIT="unknown"
    if command -v git >/dev/null 2>&1 && [ -d "$ROOT/.git" ]; then
      COMMIT="$(git -C "$ROOT" rev-parse --short HEAD 2>/dev/null || echo unknown)"
    fi
    echo "MediaForge ${MF_VER} (commit ${COMMIT})"
    echo "helper ${HELPER_VERSION}"
    if [ -f "$ROOT/config/upstream.env" ]; then
      # shellcheck disable=SC1091
      set -a
      # shellcheck source=/dev/null
      source "$ROOT/config/upstream.env"
      set +a
      echo "ffmpeg_baseline ${FFMPEG_REF:-unknown} (${FFMPEG_COMMIT:-unknown})"
    fi
    command -v "$FFMPEG" >/dev/null && "$FFMPEG" -version | head -1 || echo "ffmpeg: not found"
    command -v "$FFPROBE" >/dev/null && "$FFPROBE" -version | head -1 || echo "ffprobe: not found"
    ;;
  inspect) cmd_inspect "$@" ;;
  process) cmd_process "$@" ;;
  thumbnail) cmd_thumbnail "$@" ;;
  extract-audio|extract_audio) cmd_extract_audio "$@" ;;
  hwinfo|hw) cmd_hwinfo "$@" ;;
  probe|ffprobe) exec "$FFPROBE" "$@" ;;
  ffmpeg|run) exec "$FFMPEG" "$@" ;;
  *)
    echo "mediaforge: error: unknown command: $cmd" >&2
    echo "mediaforge: hint: try: mediaforge help" >&2
    exit 2
    ;;
esac
